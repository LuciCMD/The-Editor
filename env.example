# Live bot settings, copy to .env and fill in
# .env is git-ignored and never copied into the Docker image

# Bot token from the Discord developer portal, required
DISCORD_TOKEN=

# Genius API token for /lyrics
GENIUS_TOKEN=

# VirusTotal API key for link scanning
VIRUSTOTAL_API_KEY=

# Discord user IDs allowed to run owner commands like /gag and /restart, comma separated
AUTHORIZED_USERS=
