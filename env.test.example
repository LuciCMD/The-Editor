# Test bot settings, copy to .env.test and fill in, then run npm run dev
# .env.test is git-ignored

# Test bot token from the Discord developer portal, required
DISCORD_TOKEN=

# Test server ID, commands register there instantly instead of globally
TEST_GUILD_ID=

# Keeps test data apart from the live bot's databases
DATABASE_DIR=database/sqlite-test

GENIUS_TOKEN=
VIRUSTOTAL_API_KEY=
AUTHORIZED_USERS=
